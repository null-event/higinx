{
  "log": {
    "version": "1.2",
    "creator": {
      "name": "Test",
      "version": "1.0"
    },
    "entries": [
      {
        "request": {
          "method": "GET",
          "url": "https://accounts.example.com/login",
          "headers": []
        },
        "response": {
          "status": 200,
          "headers": [
            {
              "name": "Set-Cookie",
              "value": "csrf_token=abc123; Domain=.accounts.example.com; Path=/; Secure"
            }
          ],
          "content": {
            "mimeType": "text/html",
            "text": ""
          }
        }
      },
      {
        "request": {
          "method": "POST",
          "url": "https://accounts.example.com/api/auth/login",
          "headers": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ],
          "postData": {
            "mimeType": "application/json",
            "text": "{\"email\":\"user@test.com\",\"password\":\"testpass123\"}"
          }
        },
        "response": {
          "status": 200,
          "headers": [
            {
              "name": "Set-Cookie",
              "value": "session_id=xyz789verylongvalue; Domain=.accounts.example.com; Path=/; HttpOnly; Secure"
            },
            {
              "name": "Set-Cookie",
              "value": "auth_token=longtokenvalue12345678901234567890; Domain=.example.com; Path=/; HttpOnly; Secure"
            }
          ],
          "content": {
            "mimeType": "application/json",
            "text": "{\"success\":true}"
          }
        }
      }
    ]
  }
}
